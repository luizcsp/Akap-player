{
  "name": "akap-player",
  "version": "2.2.0",
  "description": "Player de música local com editor de tags MP3 e sincronizador de letras — 100% no navegador.",
  "private": true,
  "type": "module",
  "keywords": [
    "player",
    "mp3",
    "id3",
    "tags",
    "lyrics",
    "lrc",
    "offline",
    "browser"
  ],
  "author": "Akap Player",
  "license": "SEE LICENSE IN README.md",
  "scripts": {
    "start": "npx --yes serve . -l 8000",
    "dev": "npx --yes serve . -l 8000",
    "serve:python": "python -m http.server 8000",
    "serve:php": "php -S localhost:8000",
    "check": "node --check browser-id3-writer.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.html",
    "tools-tags.html",
    "tools-lyrics.html",
    "browser-id3-writer.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ]
}